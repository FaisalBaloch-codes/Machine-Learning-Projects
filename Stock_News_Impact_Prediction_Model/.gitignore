# ---------------------------------------------------------------- secrets
.env
*.env
!.env.example

# ---------------------------------------------------------------- local environments / caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.zip

# ---------------------------------------------------------------- regenerated by `python main.py`
# raw API downloads (news + 1-minute market bars + reference lists)
data/raw/**/*.csv
# pipeline progress files: must NOT be shared, otherwise a fresh run would think work is done
data/checkpoints/*
!data/checkpoints/.gitkeep
data/failed_requests.csv
data/**/*.bak
data/**/*.orphan
data/**/*.tmp
data/**/*.archived.*
logs/*.log

# large intermediate datasets (> 100 MB each, rebuilt by the pipeline)
data/processed/deduplicated_news.csv
data/processed/final_stock_news_impact_dataset.csv
data/processed/labeled_events.csv
data/processed/market_data.csv
data/processed/stock_news_dataset.csv

# ---------------------------------------------------------------- FinBERT training scratch
finbert_market_effect/checkpoints/
finbert_market_effect/smoke_run/
finbert_market_effect/.hf_cache/
