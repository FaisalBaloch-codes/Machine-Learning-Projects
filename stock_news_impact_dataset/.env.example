# Copy this file to .env and fill in your keys. Never commit .env.
# ---------------------------------------------------------------- credentials
ALPHA_VANTAGE_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ---------------------------------------------------------------- date range (UTC, inclusive)
START_DATE=2024-09-24
END_DATE=2026-09-25

# ---------------------------------------------------------------- output files
OUTPUT_DIR=data
NEWS_OUTPUT=stock_news_dataset.csv
RAW_NEWS_OUTPUT=raw_news.csv
MARKET_OUTPUT=market_data.csv
FAILED_OUTPUT=failed_requests.csv

# ---------------------------------------------------------------- HTTP behaviour
MAX_WORKERS=8
REQUEST_TIMEOUT=30

# ---------------------------------------------------------------- Alpha Vantage
# Free keys: 25 requests/day (5/min). Premium keys: raise both (0 = no local daily cap).
# AV_REQUESTS_PER_MINUTE=5
# AV_DAILY_REQUEST_LIMIT=25
# AV_WINDOW_HOURS=168
# ALPHA_VANTAGE_TIMEZONE=auto

# ---------------------------------------------------------------- Alpaca
# ALPACA_PAPER=true
# ALPACA_REQUESTS_PER_MINUTE=180
# ALPACA_DATA_FEED=sip
# ALPACA_SYMBOLS_PER_REQUEST=50

# ---------------------------------------------------------------- labelling
SPIKE_RETURN_THRESHOLD=0.02
CRASH_RETURN_THRESHOLD=-0.02
ABNORMAL_RETURN_Z=2.0
VOLUME_SPIKE_RATIO=1.5

# ---------------------------------------------------------------- ML-ready export
# Columns dropped from data/processed/ml_ready_dataset.csv (the final dataset keeps them)
# ML_EXCLUDE_COLUMNS=news_id,event_id,publisher,alpha_vantage_id,alpaca_id
